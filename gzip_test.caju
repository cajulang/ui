import { describe, it, expect } from "std/testing"
import "std/strings"
import "std/hash"
import "std/os"
import "std/fs"
import "gzip"

# what the system's gzip makes of z ("" when there is no gzip here)
fn gunzip(z: str) -> str {
  if os.look_path("gzip") == "" { return "" }
  dir, err := fs.temp_dir("", "caju-gzip")
  if err != nil { return "" }
  f := dir + "/x.gz"
  fs.write_file(f, z, 420)
  p, perr := os.run([]str{"gzip", "-dc", f}, nil, false)
  fs.remove_all(dir)
  if perr != nil || p.code != 0 { return "gzip failed" }
  return p.output
}

describe("gzip.compress", fn() {
  it("writes the gzip header and the trailer (CRC-32 and size)", fn() {
    z := gzip.compress("hello")
    expect(int(z[0])).to_equal(0x1f)
    expect(int(z[1])).to_equal(0x8b)
    expect(int(z[2])).to_equal(8)
    n := len(z)
    crc := int(z[n - 8]) | (int(z[n - 7]) << 8) | (int(z[n - 6]) << 16) | (int(z[n - 5]) << 24)
    expect(crc).to_equal(hash.crc32("hello") & 0xFFFFFFFF)
    expect(int(z[n - 4])).to_equal(5)
  })
  it("round-trips through the system's gzip, at both levels", fn() {
    b := strings.Builder{}
    for i := 0; i < 3000; i++ { b.write("<li class=\"item-" + str(i % 17) + "\">caju " + str(i * 7919 % 1000) + "</li>\n") }
    s := b.string()
    if os.look_path("gzip") == "" { return }
    expect(gunzip(gzip.compress(s)) == s).to_equal(true)
    expect(gunzip(gzip.compress_fast(s)) == s).to_equal(true)
    expect(gunzip(gzip.compress_fast("")) == "").to_equal(true)
    expect(len(gzip.compress_fast(s)) < len(s) / 4).to_equal(true)
  })
  it("compresses repeated text", fn() {
    s := strings.repeat("<div class=\"card\">caju</div>", 400)
    expect(len(gzip.compress(s)) < len(s) / 10).to_equal(true)
  })
  it("uses codes made for the text (dynamic Huffman) when they are shorter", fn() {
    s := strings.repeat("<p class=\"lead\">Caju compiles to native code and WebAssembly.</p>\n", 50)
    z := gzip.compress(s)
    expect((int(z[10]) >> 1) & 3).to_equal(2)
    expect(len(z) < 200).to_equal(true)
  })
  it("uses the fixed codes for a few bytes", fn() {
    z := gzip.compress("hi")
    expect((int(z[10]) >> 1) & 3).to_equal(1)
  })
  it("knows when a client takes gzip", fn() {
    expect(gzip.accepted("gzip, deflate, br")).to_equal(true)
    expect(gzip.accepted("identity")).to_equal(false)
  })
})
