# caju-ui: the command line of the ui package.
#
#   caju-ui new myapp     a new app
#   caju-ui dev           serves the app in the current directory, rebuilding and hot reloading
#                         it (keeping the components' state) when a file changes
#   caju-ui build         a static site in dist/ (index.html, the program's wasm, the runtime)
#   caju-ui preview       serves dist/
#   caju-ui gen           only turns the .cajux files into .caju
#
# With --ssr server.cajux, dev and build also compile the app's server (a native program that
# renders the pages with ui.page and serves them with ssr.serve): dev runs it and sends it every
# page request, rebuilding and restarting it when the code changes.
#
# Build it with: caju build -o build/caju-ui cmd/caju-ui.caju
import "std/cli"
import "std/os"
import "std/fs"
import "std/http"
import "std/json"
import "std/strings"
import "std/strconv"
import "std/net"
import filepath "std/path"
import "../jsx"
import "./assets"

const VERSION = "0.2.0"
const WORK = ".ui"

# ---------------------------------------------------------------------------------------------
# Files

fn skip_dir(name: str) -> bool {
  return strings.has_prefix(name, ".") || name == "node_modules" || name == "dist" || name == "build"
}

# every file under dir (relative paths), skipping hidden, build and dependency directories
fn files(dir: str) -> []str {
  out := []str{}
  walk(dir, "", &out)
  return out
}

fn walk(root: str, rel: str, out: *[]str) {
  full := root
  if rel != "" { full = filepath.join(root, rel) }
  entries, err := fs.read_dir(full)
  if err != nil { return }
  for _, e := range entries {
    r := e.name
    if rel != "" { r = rel + "/" + e.name }
    if e.is_dir {
      if !skip_dir(e.name) { walk(root, r, out) }
    } else {
      *out = append(*out, r)
    }
  }
}

# the .caju a .cajux file becomes
fn generated(cajux: str) -> str { return strings.trim_suffix(cajux, ".cajux") + ".caju" }

# turns every .cajux under dir into .caju (writing only the ones that changed)
fn gen(dir: str) -> error {
  all := files(dir)
  zero := map[str]bool{}
  srcs := map[str]str{}
  for _, f := range all {
    if !strings.has_suffix(f, ".cajux") && !strings.has_suffix(f, ".caju") { continue }
    if strings.has_suffix(f, ".caju") && fs.exists(filepath.join(dir, f + "x")) { continue }
    src, err := fs.read_file(filepath.join(dir, f))
    if err != nil { return err }
    srcs[f] = src
    jsx.components(src, filepath.stem(f), zero)
  }
  for f, src := range srcs {
    if !strings.has_suffix(f, ".cajux") { continue }
    out, err := jsx.transpile(src, f, zero)
    if err != nil { return err }
    if !strings.has_suffix(out, "\n") { out = out + "\n" }
    out = out + "# Generated by caju-ui from " + filepath.base(f) + ": edit that file, not this one.\n"
    target := filepath.join(dir, generated(f))
    old, rerr := fs.read_file(target)
    if rerr == nil && old == out { continue }
    werr := fs.write_file(target, out, 420)
    if werr != nil { return werr }
  }
  return nil
}

# the app's entry file: the one given, or main.cajux / main.caju
fn entry_of(given: str) -> str {
  if given != "" { return given }
  for _, f := range []str{"main.cajux", "main.caju", "app.cajux", "app.caju"} {
    if fs.exists(f) { return f }
  }
  return ""
}

fn caju_bin() -> str {
  b := os.getenv("CAJU")
  if b != "" { return b }
  return "caju"
}

# compiles the server (native) of an app rendered on the server; returns the error text
fn build_server(dir: str, entry: str, out: str) -> str {
  p, err := os.run([]str{caju_bin(), "build", "-o", out, generated(entry)}, nil, true)
  if err != nil { return "could not run " + caju_bin() + ": " + err.Error() }
  if p.code != 0 { return to_cajux(dir, strings.trim_space(p.output)) }
  return ""
}

# generates and compiles the app to out; returns the error text ("" if it built)
fn build_wasm(dir: str, entry: str, out: str) -> str {
  gerr := gen(dir)
  if gerr != nil { return gerr.Error() }
  p, err := os.run([]str{caju_bin(), "build", "--target", "wasm", "-o", out, generated(entry)}, nil, true)
  if err != nil { return "could not run " + caju_bin() + ": " + err.Error() + " (set CAJU to the compiler's path)" }
  if p.code != 0 { return to_cajux(dir, strings.trim_space(p.output)) }
  return ""
}

# errors in generated files point at the .cajux the user edits (the lines are the same)
fn to_cajux(dir: str, msg: str) -> str {
  for _, f := range files(dir) {
    if !strings.has_suffix(f, ".cajux") { continue }
    g := generated(f)
    msg = strings.replace_all(msg, g + ",", f + ",")
    msg = strings.replace_all(msg, g + ":", f + ":")
    msg = strings.replace_all(msg, filepath.base(g) + ",", filepath.base(f) + ",")
  }
  return msg
}

# ---------------------------------------------------------------------------------------------
# The page

fn content_type(p: str) -> str {
  switch filepath.ext(p) {
  case ".html": return "text/html; charset=utf-8"
  case ".js", ".mjs": return "text/javascript; charset=utf-8"
  case ".css": return "text/css; charset=utf-8"
  case ".json": return "application/json"
  case ".wasm": return "application/wasm"
  case ".svg": return "image/svg+xml"
  case ".png": return "image/png"
  case ".jpg", ".jpeg": return "image/jpeg"
  case ".gif": return "image/gif"
  case ".ico": return "image/x-icon"
  case ".webp": return "image/webp"
  case ".woff2": return "font/woff2"
  case ".txt": return "text/plain; charset=utf-8"
  }
  return "application/octet-stream"
}

# index.html (the app's own, or a default one) with the runtime's scripts
fn index_html(dir: str, cfg: str, base: str) -> str {
  page := ""
  own, err := fs.read_file(filepath.join(dir, "index.html"))
  if err == nil {
    page = own
  } else {
    links := ""
    names, lerr := fs.list_dir(filepath.join(dir, "public"))
    if lerr == nil {
      for _, n := range names {
        if strings.has_suffix(n, ".css") { links += "  <link rel=\"stylesheet\" href=\"" + base + n + "\">\n" }
      }
    }
    title := filepath.base(os.getwd())
    page = "<!doctype html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>" + title + "</title>\n" + links + "</head>\n<body>\n  <div id=\"app\"></div>\n</body>\n</html>\n"
  }
  scripts := "<script>window.__UI__ = " + cfg + "</script>\n<script src=\"" + base + "__ui/ui.js\" defer></script>\n"
  i := strings.last_index(page, "</body>")
  if i < 0 { return page + scripts }
  return page[0:i] + scripts + page[i:]
}

fn isolate(res: *http.Response) {
  res.set_header("Cross-Origin-Opener-Policy", "same-origin")
  res.set_header("Cross-Origin-Embedder-Policy", "require-corp")
  res.set_header("Cross-Origin-Resource-Policy", "same-origin")
}

fn send(res: *http.Response, ctype: str, body: str) {
  isolate(res)
  res.set_header("Content-Type", ctype)
  res.set_header("Cache-Control", "no-store")
  res.write(body)
}

# a file under root for a request path, or "" (no "..", no directories)
fn static_file(root: str, p: str) -> str {
  clean := filepath.clean("/" + p)
  if strings.contains(clean, "..") { return "" }
  f := filepath.join(root, clean[1:])
  if fs.is_file(f) { return f }
  return ""
}

fn runtime_asset(p: str) -> str {
  switch p {
  case "/__ui/ui.js": return assets.UI_JS
  case "/__ui/worker.js": return assets.WORKER_JS
  case "/__ui/caju-host.mjs": return assets.HOST_JS
  }
  return ""
}

# ---------------------------------------------------------------------------------------------
# caju-ui dev

struct Dev {
  dir: str
  entry: str
  wasm: str
  sid: str
  version: int
  kinds: []str          # what changed in each version: "hot", "css" or "full"
  error: str
  stamps: map[str]str
  ssr: str              # the server's entry file ("" without server rendering)
  ssr_port: int
}

let dev: *Dev = nil

fn watched(f: str) -> bool {
  ext := filepath.ext(f)
  if ext == ".caju" && fs.exists(f + "x") { return false }
  if f == "caju.lock" { return false }
  return ext == ".cajux" || ext == ".caju" || ext == ".toml" || ext == ".html" || strings.has_prefix(f, "public/")
}

# what changed since the last look: "build", "css", "full" or ""
fn (d: *Dev) scan() -> str {
  now := map[str]str{}
  kind := ""
  for _, f := range files(d.dir) {
    if !watched(f) { continue }
    st, err := fs.stat(filepath.join(d.dir, f))
    if err != nil { continue }
    stamp := str(st.mtime) + ":" + str(st.size)
    now[f] = stamp
    old, ok := d.stamps[f]
    if ok && old == stamp { continue }
    kind = stronger(kind, change_kind(f))
  }
  for f, _ := range d.stamps {
    if _, ok := now[f]; !ok { kind = stronger(kind, change_kind(f)) }
  }
  d.stamps = now
  return kind
}

fn change_kind(f: str) -> str {
  ext := filepath.ext(f)
  if ext == ".cajux" || ext == ".caju" || ext == ".toml" { return "build" }
  if ext == ".css" { return "css" }
  return "full"
}

fn rank(k: str) -> int {
  switch k {
  case "css": return 1
  case "hot": return 2
  case "build": return 2
  case "full": return 3
  }
  return 0
}

fn stronger(a: str, b: str) -> str {
  if rank(b) > rank(a) { return b }
  return a
}

fn (d: *Dev) bump(kind: str) {
  d.version++
  d.kinds = append(d.kinds, kind)
}

fn (d: *Dev) rebuild() -> bool {
  t0 := os.nanotime()
  err := build_wasm(d.dir, d.entry, d.wasm)
  if err == "" && d.ssr != "" {
    # built aside and renamed over the running one (a running binary cannot be rewritten)
    bin := filepath.join(d.dir, WORK + "/server")
    err = build_server(d.dir, d.ssr, bin + ".new")
    if err == "" {
      fs.rename(bin + ".new", bin)
      d.restart_server()
    }
  }
  ms := (os.nanotime() - t0) / 1000000
  if err != "" {
    d.error = err
    os.eprintln("\x1b[31m✗ build failed\x1b[0m (" + str(ms) + " ms)\n" + err)
    return false
  }
  d.error = ""
  print("\x1b[32m✓\x1b[0m built in " + str(ms) + " ms")
  return true
}

fn (d: *Dev) check() {
  kind := d.scan()
  if kind == "" { return }
  if kind == "build" {
    if d.rebuild() { d.bump("hot") }
    return
  }
  if kind == "css" { print("  css changed") } else { print("  page changed") }
  d.bump(kind)
}

fn (d: *Dev) poll(req: *http.Request, res: *http.Response) {
  d.check()
  since := 0
  for _, kv := range strings.split(req.query, "&") {
    if strings.has_prefix(kv, "v=") {
      n, err := strconv.atoi(kv[2:])
      if err == nil { since = n }
    }
  }
  kind := ""
  for v := since + 1; v <= d.version; v++ {
    if v - 1 < len(d.kinds) { kind = stronger(kind, d.kinds[v - 1]) }
  }
  body, _ := json.marshal(map[str]any{"sid": d.sid, "v": d.version, "kind": kind, "error": d.error})
  send(res, "application/json", body)
}

# the dev page: index.html with the runtime's scripts and the dev settings
fn (d: *Dev) page_template() -> str {
  cfg, _ := json.marshal(map[str]any{"dev": true, "v": d.version, "sid": d.sid, "wasm": "/__ui/app.wasm", "worker": "/__ui/worker.js"})
  return index_html(d.dir, cfg, "/")
}

fn (d: *Dev) stop_server() {
  pid, err := fs.read_file(filepath.join(d.dir, WORK + "/server.pid"))
  if err == nil && strings.trim_space(pid) != "" {
    os.run([]str{"kill", strings.trim_space(pid)}, nil, true)
    fs.remove(filepath.join(d.dir, WORK + "/server.pid"))
  }
}

# starts the app's server in the background (it stops when this program does)
fn (d: *Dev) restart_server() {
  d.stop_server()
  w := filepath.join(d.dir, WORK)
  envs := "UI_DEV=1 PORT=" + str(d.ssr_port) + " UI_TEMPLATE=" + w + "/index.html UI_DIST=" + filepath.join(d.dir, "public")
  script := "(" + envs + " " + w + "/server > " + w + "/server.log 2>&1 & s=$!; echo $s > " + w + "/server.pid; while kill -0 " + str(os.getpid()) + " 2>/dev/null; do sleep 1; done; kill $s) > /dev/null 2>&1 &"
  fs.write_file(filepath.join(w, "index.html"), d.page_template(), 420)
  os.run([]str{"sh", "-c", script}, nil, true)
}

# the page from the app's server: (status, body, error)
fn (d: *Dev) render_page(target: str) -> (int, str, str) {
  fs.write_file(filepath.join(d.dir, WORK + "/index.html"), d.page_template(), 420)
  # the server may still be starting: try for about 5 seconds
  url := "http://127.0.0.1:" + str(d.ssr_port) + target
  for i := 0; i < 50; i++ {
    r, err := http.request(&http.ClientRequest{url: url, headers: map[str]str{"Connection": "close"}, no_redirects: true, timeout_ms: 30000})
    if err == nil { return r.status, r.body, "" }
    if !strings.contains(err.Error(), "connection refused") { return 0, "", "the app's server: " + err.Error() }
    sleep(0.1)
  }
  log, _ := fs.read_file(filepath.join(d.dir, WORK + "/server.log"))
  return 0, "", "the app's server (" + d.ssr + ") is not answering on port " + str(d.ssr_port) + "\n" + log
}

fn (d: *Dev) serve(req: *http.Request, res: *http.Response) {
  p := req.path
  if p == "/__ui/poll" {
    d.poll(req, res)
    return
  }
  if p == "/__ui/app.wasm" {
    data, err := fs.read_file(d.wasm)
    if err != nil {
      res.set_status(503)
      send(res, "text/plain", "the app has not built yet")
      return
    }
    send(res, "application/wasm", data)
    return
  }
  a := runtime_asset(p)
  if a != "" {
    send(res, "text/javascript; charset=utf-8", a)
    return
  }
  f := static_file(filepath.join(d.dir, "public"), p)
  if f != "" {
    data, _ := fs.read_file(f)
    send(res, content_type(f), data)
    return
  }
  if filepath.ext(p) != "" && p != "/index.html" {
    res.set_status(404)
    send(res, "text/plain", "not found: " + p)
    return
  }
  # the page (also for any route without an extension: client-side routing)
  if d.ssr != "" && d.error == "" {
    target := p
    if req.query != "" { target = p + "?" + req.query }
    status, body, rerr := d.render_page(target)
    if rerr == "" {
      res.set_status(status)
      send(res, "text/html; charset=utf-8", body)
      return
    }
    d.error = rerr
    os.eprintln("\x1b[31m✗ server rendering failed\x1b[0m\n" + rerr)
  }
  send(res, "text/html; charset=utf-8", d.page_template())
}

fn cmd_dev(m: *cli.Match) {
  dir := os.getwd()
  entry := entry_of(m.arg("entry"))
  if entry == "" { die("no main.cajux or main.caju here (or give the entry file)") }
  fs.mkdir_all(filepath.join(dir, WORK), 493)
  d := &Dev{dir: dir, entry: entry, wasm: filepath.join(dir, WORK + "/app.wasm"), sid: str(os.nanotime()), stamps: map[str]str{}}
  d.ssr = m.str("ssr")
  d.ssr_port = m.int("port") + 1
  if d.ssr != "" && !fs.exists(d.ssr) { die(d.ssr + " not found") }
  dev = d
  d.stop_server()
  d.scan()
  d.rebuild()
  port := m.int("port")
  mode := ""
  if d.ssr != "" { mode = ", rendered on the server by " + d.ssr }
  print("\x1b[1mcaju-ui dev\x1b[0m  http://localhost:" + str(port) + "   (" + entry + mode + "; saving a file hot reloads the page)")
  http.handle("/", fn(req: *http.Request, res: *http.Response) { dev.serve(req, res) })
  err := http.listen_and_serve(m.str("host"), port)
  if err != nil { die(err.Error()) }
}

# ---------------------------------------------------------------------------------------------
# caju-ui build / preview / gen / new

fn cmd_build(m: *cli.Match) {
  dir := os.getwd()
  entry := entry_of(m.arg("entry"))
  if entry == "" { die("no main.cajux or main.caju here (or give the entry file)") }
  out := m.str("out")
  fs.mkdir_all(filepath.join(out, "__ui"), 493)
  t0 := os.nanotime()
  err := build_wasm(dir, entry, filepath.join(out, "__ui/app.wasm"))
  if err != "" { die("build failed\n" + err) }
  fs.write_file(filepath.join(out, "__ui/ui.js"), assets.UI_JS, 420)
  fs.write_file(filepath.join(out, "__ui/worker.js"), assets.WORKER_JS, 420)
  fs.write_file(filepath.join(out, "__ui/caju-host.mjs"), assets.HOST_JS, 420)
  # the files of public/ go to the root of the site
  if fs.is_dir("public") {
    for _, f := range files("public") {
      fs.mkdir_all(filepath.dir(filepath.join(out, f)), 493)
      fs.copy_file(filepath.join("public", f), filepath.join(out, f))
    }
  }
  # absolute paths, so pages at any depth (/en/docs) find the runtime; --base for a subpath
  base := m.str("base")
  if !strings.has_suffix(base, "/") { base = base + "/" }
  cfg, _ := json.marshal(map[str]any{"dev": false, "wasm": base + "__ui/app.wasm", "worker": base + "__ui/worker.js"})
  fs.write_file(filepath.join(out, "index.html"), index_html(dir, cfg, base), 420)
  # the headers the page needs (SharedArrayBuffer), for hosts that read these files
  fs.write_file(filepath.join(out, "_headers"), "/*\n  Cross-Origin-Opener-Policy: same-origin\n  Cross-Origin-Embedder-Policy: require-corp\n", 420)
  fs.write_file(filepath.join(out, "vercel.json"), "{\n  \"headers\": [{\n    \"source\": \"/(.*)\",\n    \"headers\": [\n      { \"key\": \"Cross-Origin-Opener-Policy\", \"value\": \"same-origin\" },\n      { \"key\": \"Cross-Origin-Embedder-Policy\", \"value\": \"require-corp\" }\n    ]\n  }]\n}\n", 420)
  st, _ := fs.stat(filepath.join(out, "__ui/app.wasm"))
  print("built " + out + "/ in " + str((os.nanotime() - t0) / 1000000) + " ms (app.wasm: " + str(st.size / 1024) + " KB)")
  ssr := m.str("ssr")
  if ssr != "" {
    bin := filepath.stem(ssr)
    # built aside and renamed over it (the server may be running)
    serr := build_server(dir, ssr, bin + ".new")
    if serr != "" { die("server build failed\n" + serr) }
    fs.rename(bin + ".new", bin)
    print("built ./" + bin + " (the server: UI_DIST=" + out + " ./" + bin + ")")
  }
}

let preview_dir: str = ""

fn cmd_preview(m: *cli.Match) {
  preview_dir = m.str("out")
  if !fs.is_file(filepath.join(preview_dir, "index.html")) { die(preview_dir + "/index.html not found: run caju-ui build first") }
  port := m.int("port")
  print("caju-ui preview  http://localhost:" + str(port) + "   (" + preview_dir + "/)")
  http.handle("/", fn(req: *http.Request, res: *http.Response) {
    f := static_file(preview_dir, req.path)
    if f == "" || req.path == "/" { f = filepath.join(preview_dir, "index.html") }
    data, _ := fs.read_file(f)
    isolate(res)
    res.set_header("Content-Type", content_type(f))
    res.write(data)
  })
  err := http.listen_and_serve(m.str("host"), port)
  if err != nil { die(err.Error()) }
}

fn cmd_gen(m: *cli.Match) {
  err := gen(os.getwd())
  if err != nil { die(err.Error()) }
}

const NEW_MAIN = "import \"github.com/cajulang/ui\"\n\nfn App() -> *ui.Node {\n  count := ui.use_int(0)\n  return (\n    <main class=\"app\">\n      <h1>Hello from Caju</h1>\n      <button onClick={fn() { count.set(count.v + 1) }}>\n        clicked {count.v} times\n      </button>\n      <p>Edit main.cajux and save: the page updates and keeps the count.</p>\n    </main>\n  )\n}\n\nui.mount(\"#app\", <App />)\n"

const NEW_CSS = "body { font-family: system-ui, sans-serif; margin: 0; display: grid; place-items: center; min-height: 100vh; }\n.app { text-align: center; }\nbutton { font-size: 1.1rem; padding: .6rem 1.2rem; border-radius: .5rem; border: 1px solid #ccc; cursor: pointer; }\n"

fn cmd_new(m: *cli.Match) {
  name := m.arg("name")
  if fs.exists(name) { die(name + " already exists") }
  fs.mkdir_all(filepath.join(name, "public"), 493)
  fs.write_file(filepath.join(name, "main.cajux"), NEW_MAIN, 420)
  fs.write_file(filepath.join(name, "public/style.css"), NEW_CSS, 420)
  fs.write_file(filepath.join(name, ".gitignore"), ".ui/\ndist/\n# generated from the .cajux files\n*.caju\n", 420)
  print("created " + name + "/. Next:\n  cd " + name + "\n  caju pkg init && caju pkg add github.com/cajulang/ui\n  caju-ui dev")
}

fn die(msg: str) {
  os.eprintln("caju-ui: " + msg)
  os.exit(1)
}

app := cli.app("caju-ui", "React-style UIs in Caju, rendered from WebAssembly").version(VERSION)
app.describe("Components are written in .cajux files: Caju with JSX-like elements. caju-ui turns\nthem into .caju, compiles the app with caju build --target wasm and serves it.")

dev_cmd := app.sub("dev", "serve the app with hot reload")
dev_cmd.arg_opt("entry", "the entry file (default: main.cajux)")
dev_cmd.flag_int("port", "p", "port", 5173, "the port")
dev_cmd.flag_str("host", "", "host", "127.0.0.1", "the address to listen on")
dev_cmd.flag_str("ssr", "", "file", "", "render the pages on the server with this program (it listens on port + 1)")
dev_cmd.action(cmd_dev)

build_cmd := app.sub("build", "build a static site")
build_cmd.arg_opt("entry", "the entry file (default: main.cajux)")
build_cmd.flag_str("out", "o", "dir", "dist", "the output directory")
build_cmd.flag_str("ssr", "", "file", "", "also compile this server program (native)")
build_cmd.flag_str("base", "", "path", "/", "the path the site is served under")
build_cmd.action(cmd_build)

preview_cmd := app.sub("preview", "serve a build")
preview_cmd.flag_str("out", "o", "dir", "dist", "the build's directory")
preview_cmd.flag_int("port", "p", "port", 4173, "the port")
preview_cmd.flag_str("host", "", "host", "127.0.0.1", "the address to listen on")
preview_cmd.action(cmd_preview)

gen_cmd := app.sub("gen", "turn the .cajux files into .caju")
gen_cmd.action(cmd_gen)

new_cmd := app.sub("new", "create an app")
new_cmd.arg("name", "the directory to create")
new_cmd.action(cmd_new)

app.run(os.args()[1:])
